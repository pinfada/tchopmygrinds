# See http://help.github.com/ignore-files/ for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile ~/.gitignore_global

# Ignore bundler config
/.bundle

# Gems installés localement. Le dépôt a longtemps versionné un bundle Ruby 2.5
# (~133 Mo, 9880 fichiers) devenu mort avec le passage à Ruby 3.3 : il ne
# servait plus à rien, gonflait chaque `COPY . .` et chaque image construite.
/vendor/bundle

# Core dumps déposés par un crash — jamais du code, parfois de la mémoire
# de processus.
/core.*

# Ignore the default SQLite database (and the WAL/SHM sidecar files Rails 7.1 emits).
/db/*.sqlite3
/db/*.sqlite3-shm
/db/*.sqlite3-wal
/db/*.sqlite3-journal

# Base sqlite de la sandbox railsbox — DATABASE_URL=sqlite3:storage/production.sqlite3.
# Construite dans l'image, jamais dans le dépôt.
/storage/*.sqlite3*

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp

# Ignore application configuration
/config/application.yml
sendgrid.env
node_modules/
app/assets/builds/
!app/assets/builds/.keep

# Personal Claude Code settings (per-developer, not team-wide)
.claude/settings.local.json

# Secrets and per-developer env files (never commit)
.env
.env.local
.env.*.local
/config/master.key
/config/credentials/*.key

# RSpec run state
/spec/examples.txt

