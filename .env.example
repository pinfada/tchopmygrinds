# Sample environment file. Copy to .env (or .env.local) and fill in your values.
# DO NOT commit .env. The .env.example is committed as documentation only.

# --- Core Rails ---
# Generate with: bin/rails secret
SECRET_KEY_BASE=

# --- Devise / JWT ---
# Optional override. If unset, falls back to SECRET_KEY_BASE.
DEVISE_JWT_SECRET_KEY=

# --- Database (production) ---
# Render sets this automatically. For local Postgres only:
# DATABASE_URL=postgres://user:password@localhost:5432/tchopmygrinds_dev

# --- Mail / SendGrid ---
SENDGRID_USERNAME=
SENDGRID_PASSWORD=

# --- Mailchimp ---
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# --- App-level ---
DOMAIN_NAME=example.com
OWNER_EMAIL=
FRONTEND_URL=http://localhost:3001
# Public canonical URL used in meta tags, canonical link, sitemap and JSON-LD.
# Required in production; falls back to request host_with_port if unset.
SITE_URL=https://tchopmygrinds.com

# --- Rails runtime ---
RAILS_ENV=development
RAILS_LOG_LEVEL=info
RAILS_SERVE_STATIC_FILES=true
