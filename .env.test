# Variables d'environnement pour les tests E2E
# Copier vers .env.local pour le développement

# Configuration des tests
NODE_ENV=test
CI=false
RAILS_ENV=test

# URLs des services
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000/api/v1

# Configuration Puppeteer
PUPPETEER_HEADLESS=false
PUPPETEER_SLOW_MO=100
PUPPETEER_TIMEOUT=30000
PUPPETEER_VIEWPORT_WIDTH=1280
PUPPETEER_VIEWPORT_HEIGHT=720

# Configuration des tests E2E
E2E_PARALLEL=false
E2E_RETRIES=2
E2E_SCREENSHOT_ON_FAILURE=true
E2E_VIDEO_RECORDING=false
E2E_CLEANUP_AFTER_TESTS=true

# Utilisateurs de test (créés par seeds_test_users_simple.rb)
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=password123
TEST_MERCHANT_EMAIL=merchant@test.com
TEST_MERCHANT_PASSWORD=password123
TEST_CUSTOMER_EMAIL=customer@test.com
TEST_CUSTOMER_PASSWORD=password123
TEST_VERIFIED_MERCHANT_EMAIL=verified_merchant@test.com
TEST_VERIFIED_MERCHANT_PASSWORD=password123
TEST_BUYER_EMAIL=test_buyer@test.com
TEST_BUYER_PASSWORD=password123

# Configuration de la détection de régressions
REGRESSION_BASELINE_PATH=./tests/baseline/baseline.json
REGRESSION_THRESHOLD_HIGH=0.1
REGRESSION_THRESHOLD_MEDIUM=0.2
REGRESSION_VISUAL_THRESHOLD=0.05

# Configuration des rapports
REPORT_OUTPUT_DIR=./test-reports
ARTIFACTS_DIR=./test-artifacts
SCREENSHOTS_DIR=./test-screenshots

# Configuration CI/CD (pour GitHub Actions)
# Ces variables sont automatiquement définies par GitHub Actions
# GITHUB_REF_NAME=
# GITHUB_SHA=
# GITHUB_EVENT_NAME=
# GITHUB_WORKSPACE=

# Configuration optionnelle pour notifications
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# EMAIL_NOTIFICATION_ADDRESS=