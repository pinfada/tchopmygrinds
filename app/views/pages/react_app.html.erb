<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= @titre %></title>
  
  <!-- React app built assets -->
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <!-- Always use built version to avoid Vite dev server conflicts -->
  <% @vite_assets.fetch(:stylesheets).each do |stylesheet_path| %>
    <link rel="stylesheet" crossorigin href="<%= stylesheet_path %>">
  <% end %>
  <% @vite_assets.fetch(:scripts).each do |script_path| %>
    <script type="module" crossorigin src="<%= script_path %>"></script>
  <% end %>
</head>
<body>
  <div id="root"></div>
  
  <!-- Pass Rails data to React -->
  <script type="text/javascript">
    window.railsData = {
      csrfToken: '<%= form_authenticity_token %>',
      currentUser: <%= current_user&.as_json&.to_json || 'null' %>,
      apiBaseUrl: '<%= Rails.env.development? ? 'http://localhost:3000' : request.base_url %>',
      environment: '<%= Rails.env %>'
    };
  </script>
</body>
</html>
